@page "/targets/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject TargetService TargetService
@inject StatisticsService Statistics
@inject CurrentUserAccessor CurrentUser
@inject MonitorBroadcaster Broadcaster

<PageTitle>@(target?.Name ?? "Target")</PageTitle>

@if (target is null)
{
    <p>Target not found.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@target.Name <StatusBadge Status="target.Status" /></h1>
        <a class="btn btn-outline-secondary" href="targets/@target.Id/edit">Edit</a>
    </div>

    <p class="text-body-secondary">
        @target.Kind — @target.Address@(target.Port is { } port ? $":{port}" : "")
        · every @target.CheckIntervalSeconds s
        · last checked @(target.LastCheckedAt?.ToLocalTime().ToString("g") ?? "never")
    </p>

    <div class="btn-group mb-3">
        @foreach (var option in windows)
        {
            <button class="btn btn-sm @(option.Key == window.Key ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => ChangeWindowAsync(option)">@option.Key</button>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary small">Uptime</div>
                <div class="fs-3">@stats.UptimePercent.ToString("0.0")%</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary small">Error rate</div>
                <div class="fs-3">@stats.ErrorRatePercent.ToString("0.0")%</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary small">Avg response</div>
                <div class="fs-3">@(stats.AverageResponseTimeMs is { } avg ? $"{avg:0} ms" : "—")</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary small">Checks</div>
                <div class="fs-3">@stats.TotalChecks</div>
            </div></div>
        </div>
    </div>

    <h2 class="fs-5">Recent checks</h2>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>When</th>
                <th>Status</th>
                <th>Response</th>
                <th>Error</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var check in recent)
            {
                <tr>
                    <td>@check.CheckedAt.ToLocalTime().ToString("g")</td>
                    <td><StatusBadge Status="check.Status" /></td>
                    <td>@(check.ResponseTimeMs is { } ms ? $"{ms} ms" : "—")</td>
                    <td class="text-truncate" style="max-width: 24rem;">@check.Error</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private static readonly KeyValuePair<string, TimeSpan>[] windows =
    [
        new("24h", TimeSpan.FromHours(24)),
        new("7d", TimeSpan.FromDays(7)),
        new("30d", TimeSpan.FromDays(30))
    ];

    private KeyValuePair<string, TimeSpan> window = windows[0];
    private string ownerId = string.Empty;
    private MonitoredTarget? target;
    private TargetStatistics stats = TargetStatistics.Empty;
    private IReadOnlyList<CheckResult> recent = [];

    protected override async Task OnInitializedAsync()
    {
        ownerId = await CurrentUser.GetIdAsync();
        target = await TargetService.GetAsync(Id, ownerId);
        if (target is null)
        {
            return;
        }

        await LoadAsync();
        Broadcaster.StatusUpdated += OnStatusUpdated;
    }

    private async Task LoadAsync()
    {
        stats = await Statistics.GetStatisticsAsync(Id, DateTimeOffset.UtcNow - window.Value);
        recent = await Statistics.GetRecentChecksAsync(Id, 25);
    }

    private async Task ChangeWindowAsync(KeyValuePair<string, TimeSpan> selected)
    {
        window = selected;
        await LoadAsync();
    }

    private void OnStatusUpdated(string owner, TargetStatusUpdate update)
    {
        if (owner != ownerId || update.TargetId != Id || target is null)
        {
            return;
        }

        target.Status = update.Status;
        target.LastCheckedAt = update.CheckedAt;
        target.LastResponseTimeMs = update.ResponseTimeMs;

        InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Broadcaster.StatusUpdated -= OnStatusUpdated;
}
